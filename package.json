{
  "name": "pixelgen",
  "version": "1.1.2",
  "description": "A fully functional Machine Learning framework for PixelArt generation, built from scratch in TypeScript with complete backpropagation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "pkg/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "if (Test-Path dist) { Remove-Item -Recurse -Force dist }",
    "prepublishOnly": "npm run build",
    "example:basic": "npm run build && node dist/examples/basic-training.js",
    "example:advanced": "npm run build && node dist/examples/advanced-usage.js",
    "example:images": "npm run build && node dist/examples/train-with-images.js",
    "example:checkpointing": "npm run build && node dist/examples/checkpointing-example.js",
    "prepare": "npm run build",
    "wasm:build": "cd wasm && wasm-pack build --target nodejs --out-dir ../pkg --out-name pixelgen_wasm",
    "wasm:clean": "if (Test-Path pkg) { Remove-Item -Recurse -Force pkg }"
  },
  "keywords": [
    "pixelart",
    "pixel-art",
    "machine-learning",
    "neural-network",
    "deep-learning",
    "image-generation",
    "autoencoder",
    "typescript",
    "cpu-training",
    "game-development",
    "sprite-generation",
    "retro-graphics",
    "computer-vision",
    "ml-from-scratch",
    "backpropagation",
    "autograd"
  ],
  "author": "Harpia AI Research",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harpia-AI-Research/PixelGen.git"
  },
  "bugs": {
    "url": "https://github.com/Harpia-AI-Research/PixelGen/issues"
  },
  "homepage": "https://github.com/Harpia-AI-Research/PixelGen#readme",
  "dependencies": {
    "pngjs": "^7.0.0",
    "jpeg-js": "^0.4.4"
  },
  "optionalDependencies": {
    "pixelgen-wasm": "file:pkg"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.0",
    "typescript": "^5.0.0",
    "wasm-pack": "^0.12.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
